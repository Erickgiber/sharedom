{
  "manifest_version": 3,
  "name": "ShareDOM - DOM Screenshot Inspector",
  "version": "1.5.0",
  "description": "Inspect and capture any DOM element, console logs and network requests, and record your screen in high quality. 8 languages.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "offscreen",
    "downloads"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Toggle DOM Inspector"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Capture a screen area"
    },
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Start or stop screen recording"
    }
  }
}