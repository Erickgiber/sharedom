{
  "printWidth": 110,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "src/**/*.ts",
      "options": { "tabWidth": 4 }
    },
    {
      "files": "*.html",
      "options": { "printWidth": 120, "htmlWhitespaceSensitivity": "strict" }
    },
    {
      "files": "*.md",
      "options": { "proseWrap": "preserve" }
    }
  ]
}
