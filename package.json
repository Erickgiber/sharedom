{
  "name": "sharedom",
  "version": "1.3.0",
  "description": "Fast and lightweight DOM snapshot, screenshot, PDF and console/network capture library for browser, SSR and automated testing.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "require": "./dist/ssr.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:tracker-source && tsup src/index.ts src/ssr.ts src/testing.ts --format esm,cjs --dts --clean",
    "build:tracker-source": "node scripts/generate-tracker-source.mjs",
    "build:extension": "node extension/scripts/build.mjs",
    "zip:extension": "node extension/scripts/package.mjs",
    "build:preview": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "prepare": "node scripts/generate-tracker-source.mjs",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish",
    "assets:store": "npm run build:extension && npm run build:preview && node store-assets/scripts/capture-store-assets.mjs",
    "assets:seo": "npm run build && node preview/scripts/generate-seo-assets.mjs",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "keywords": [
    "sharedom",
    "dom",
    "snapshot",
    "screenshot",
    "pdf",
    "ssr",
    "canvas",
    "svg",
    "nextjs",
    "sveltekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Erickgiber/sharedom.git"
  },
  "homepage": "https://erickgiber.github.io/sharedom/",
  "bugs": {
    "url": "https://github.com/Erickgiber/sharedom/issues"
  },
  "author": "Erickgiber",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/chrome": "^0.2.7",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "three": "^0.186.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
